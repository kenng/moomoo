# Moomoo OpenD (must be running and logged in)
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# Trading — paper only until you explicitly enable live
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false

# Trade account queries (order history page — read-only, independent of TRADING_MODE)
# SECURITY_FIRM must match your brokerage (FUTUMY, FUTUSG, FUTUSECURITIES, …)
SECURITY_FIRM=FUTUMY
# REAL = live book; SIMULATE = paper. Toggle also available on /orders?trd_env=
ORDERS_TRD_ENV=REAL
# 0 = all accounts for ORDERS_TRD_ENV; else a specific acc_id
TRD_ACC_ID=0

# Local paths
WATCHLIST_PATH=watchlist.yaml
DATABASE_URL=sqlite:///./data/momo.db

# Jobs
NEWS_MAX_COUNT=50
NEWS_TOP_N=10

# Finnhub company news (optional — merged with OpenD on refresh; leave empty to skip)
FINNHUB_API_KEY=
FINNHUB_NEWS_LOOKBACK_DAYS=7

# Cursor SDK for AI news summaries (leave empty to disable)
# Create a key at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Google Sheets sync (optional — service account JSON; share the sheet with the SA email)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/google-sheets.json
GOOGLE_SHEETS_STOCK_ORDERS_TAB=stock orders

# Web UI login (leave AUTH_USERNAME or AUTH_PASSWORD empty to disable)
AUTH_USERNAME=
AUTH_PASSWORD=
SESSION_SECRET=

# Telegram (Phase 2 — leave empty for now)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
