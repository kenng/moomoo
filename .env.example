# Moomoo OpenD (must be running and logged in)
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# Trading — paper only until you explicitly enable live
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false

# Local paths
WATCHLIST_PATH=watchlist.yaml
DATABASE_URL=sqlite:///./data/momo.db

# Jobs
NEWS_MAX_COUNT=50
NEWS_TOP_N=10

# Telegram (Phase 2 — leave empty for now)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
